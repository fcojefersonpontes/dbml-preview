// =====================================================
// E-Commerce Platform Database Schema
// Example DBML for testing ERD Viewer Extension
// =====================================================

Project ecommerce_platform {
  database_type: 'PostgreSQL'
  Note: 'Complete e-commerce database with multiple schemas'
}

// =====================================================
// SCHEMA: core - Core business entities
// =====================================================

Table core.users [headercolor: #3498db] {
  id int [pk, increment]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  first_name varchar(100)
  last_name varchar(100)
  phone varchar(20)
  avatar_url varchar(500)
  is_active boolean [default: true]
  email_verified boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Main users table for customers and admins'
}

Table core.user_roles [headercolor: #3498db] {
  id int [pk, increment]
  user_id int [not null, ref: > core.users.id]
  role_id int [not null, ref: > core.roles.id]
  assigned_at timestamp [default: `now()`]
  assigned_by int [ref: > core.users.id]
}

Table core.roles [headercolor: #3498db] {
  id int [pk, increment]
  name varchar(50) [unique, not null]
  description text
  permissions jsonb
  created_at timestamp [default: `now()`]
}

Table core.addresses [headercolor: #3498db] {
  id int [pk, increment]
  user_id int [not null, ref: > core.users.id]
  type address_type [not null]
  street varchar(255) [not null]
  number varchar(20)
  complement varchar(100)
  neighborhood varchar(100)
  city varchar(100) [not null]
  state varchar(50) [not null]
  country varchar(50) [not null, default: 'Brazil']
  postal_code varchar(20) [not null]
  is_default boolean [default: false]
  created_at timestamp [default: `now()`]
}

// =====================================================
// SCHEMA: catalog - Product catalog
// =====================================================

Table catalog.categories [headercolor: #9b59b6] {
  id int [pk, increment]
  name varchar(100) [not null]
  slug varchar(100) [unique, not null]
  description text
  parent_id int [ref: > catalog.categories.id]
  image_url varchar(500)
  is_active boolean [default: true]
  sort_order int [default: 0]
  created_at timestamp [default: `now()`]
  
  Note: 'Hierarchical product categories'
}

Table catalog.brands [headercolor: #9b59b6] {
  id int [pk, increment]
  name varchar(100) [not null]
  slug varchar(100) [unique, not null]
  logo_url varchar(500)
  website varchar(255)
  description text
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
}

Table catalog.products [headercolor: #9b59b6] {
  id int [pk, increment]
  sku varchar(50) [unique, not null]
  name varchar(255) [not null]
  slug varchar(255) [unique, not null]
  description text
  short_description varchar(500)
  category_id int [not null, ref: > catalog.categories.id]
  brand_id int [ref: > catalog.brands.id]
  base_price decimal(10,2) [not null]
  cost_price decimal(10,2)
  weight decimal(8,3)
  dimensions jsonb
  is_active boolean [default: true]
  is_featured boolean [default: false]
  meta_title varchar(255)
  meta_description varchar(500)
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Main products table'
}

Table catalog.product_variants [headercolor: #9b59b6] {
  id int [pk, increment]
  product_id int [not null, ref: > catalog.products.id]
  sku varchar(50) [unique, not null]
  name varchar(255)
  price decimal(10,2)
  stock_quantity int [default: 0]
  attributes jsonb
  image_url varchar(500)
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
}

Table catalog.product_images [headercolor: #9b59b6] {
  id int [pk, increment]
  product_id int [not null, ref: > catalog.products.id]
  url varchar(500) [not null]
  alt_text varchar(255)
  sort_order int [default: 0]
  is_primary boolean [default: false]
  created_at timestamp [default: `now()`]
}

Table catalog.product_tags [headercolor: #9b59b6] {
  id int [pk, increment]
  product_id int [not null, ref: > catalog.products.id]
  tag_id int [not null, ref: > catalog.tags.id]
  
  indexes {
    (product_id, tag_id) [unique]
  }
}

Table catalog.tags [headercolor: #9b59b6] {
  id int [pk, increment]
  name varchar(50) [unique, not null]
  slug varchar(50) [unique, not null]
  created_at timestamp [default: `now()`]
}

// =====================================================
// SCHEMA: sales - Orders and transactions
// =====================================================

Table sales.carts [headercolor: #e74c3c] {
  id int [pk, increment]
  user_id int [ref: > core.users.id]
  session_id varchar(100)
  status cart_status [default: 'active']
  expires_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table sales.cart_items [headercolor: #e74c3c] {
  id int [pk, increment]
  cart_id int [not null, ref: > sales.carts.id]
  product_id int [not null, ref: > catalog.products.id]
  variant_id int [ref: > catalog.product_variants.id]
  quantity int [not null, default: 1]
  unit_price decimal(10,2) [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table sales.orders [headercolor: #e74c3c] {
  id int [pk, increment]
  order_number varchar(50) [unique, not null]
  user_id int [not null, ref: > core.users.id]
  status order_status [not null, default: 'pending']
  subtotal decimal(10,2) [not null]
  discount_amount decimal(10,2) [default: 0]
  shipping_amount decimal(10,2) [default: 0]
  tax_amount decimal(10,2) [default: 0]
  total_amount decimal(10,2) [not null]
  currency varchar(3) [default: 'BRL']
  shipping_address_id int [ref: > core.addresses.id]
  billing_address_id int [ref: > core.addresses.id]
  coupon_id int [ref: > sales.coupons.id]
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Customer orders'
}

Table sales.order_items [headercolor: #e74c3c] {
  id int [pk, increment]
  order_id int [not null, ref: > sales.orders.id]
  product_id int [not null, ref: > catalog.products.id]
  variant_id int [ref: > catalog.product_variants.id]
  product_name varchar(255) [not null]
  sku varchar(50) [not null]
  quantity int [not null]
  unit_price decimal(10,2) [not null]
  discount_amount decimal(10,2) [default: 0]
  total_price decimal(10,2) [not null]
  created_at timestamp [default: `now()`]
}

Table sales.order_history [headercolor: #e74c3c] {
  id int [pk, increment]
  order_id int [not null, ref: > sales.orders.id]
  status order_status [not null]
  comment text
  created_by int [ref: > core.users.id]
  created_at timestamp [default: `now()`]
}

Table sales.coupons [headercolor: #e74c3c] {
  id int [pk, increment]
  code varchar(50) [unique, not null]
  description text
  discount_type discount_type [not null]
  discount_value decimal(10,2) [not null]
  min_order_amount decimal(10,2)
  max_discount_amount decimal(10,2)
  usage_limit int
  usage_count int [default: 0]
  starts_at timestamp
  expires_at timestamp
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
}

// =====================================================
// SCHEMA: payments - Payment processing
// =====================================================

Table payments.transactions [headercolor: #f39c12] {
  id int [pk, increment]
  order_id int [not null, ref: > sales.orders.id]
  payment_method payment_method [not null]
  gateway varchar(50) [not null]
  gateway_transaction_id varchar(100)
  amount decimal(10,2) [not null]
  currency varchar(3) [default: 'BRL']
  status payment_status [not null, default: 'pending']
  error_message text
  metadata jsonb
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Payment transactions'
}

Table payments.refunds [headercolor: #f39c12] {
  id int [pk, increment]
  transaction_id int [not null, ref: > payments.transactions.id]
  amount decimal(10,2) [not null]
  reason text
  status refund_status [not null, default: 'pending']
  gateway_refund_id varchar(100)
  processed_at timestamp
  created_at timestamp [default: `now()`]
}

Table payments.payment_methods [headercolor: #f39c12] {
  id int [pk, increment]
  user_id int [not null, ref: > core.users.id]
  type payment_method [not null]
  provider varchar(50)
  token varchar(255)
  last_four varchar(4)
  expiry_month int
  expiry_year int
  is_default boolean [default: false]
  created_at timestamp [default: `now()`]
}

// =====================================================
// SCHEMA: inventory - Stock management
// =====================================================

Table inventory.warehouses [headercolor: #1abc9c] {
  id int [pk, increment]
  name varchar(100) [not null]
  code varchar(20) [unique, not null]
  address_id int [ref: > core.addresses.id]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
}

Table inventory.stock [headercolor: #1abc9c] {
  id int [pk, increment]
  warehouse_id int [not null, ref: > inventory.warehouses.id]
  product_id int [not null, ref: > catalog.products.id]
  variant_id int [ref: > catalog.product_variants.id]
  quantity int [not null, default: 0]
  reserved_quantity int [default: 0]
  reorder_level int [default: 10]
  updated_at timestamp [default: `now()`]
  
  indexes {
    (warehouse_id, product_id, variant_id) [unique]
  }
}

Table inventory.stock_movements [headercolor: #1abc9c] {
  id int [pk, increment]
  stock_id int [not null, ref: > inventory.stock.id]
  movement_type stock_movement_type [not null]
  quantity int [not null]
  reference_type varchar(50)
  reference_id int
  notes text
  created_by int [ref: > core.users.id]
  created_at timestamp [default: `now()`]
}

// =====================================================
// SCHEMA: reviews - Product reviews and ratings
// =====================================================

Table reviews.product_reviews [headercolor: #e67e22] {
  id int [pk, increment]
  product_id int [not null, ref: > catalog.products.id]
  user_id int [not null, ref: > core.users.id]
  order_id int [ref: > sales.orders.id]
  rating int [not null]
  title varchar(255)
  content text
  pros text
  cons text
  is_verified_purchase boolean [default: false]
  is_approved boolean [default: false]
  helpful_count int [default: 0]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Customer product reviews'
}

Table reviews.review_images [headercolor: #e67e22] {
  id int [pk, increment]
  review_id int [not null, ref: > reviews.product_reviews.id]
  url varchar(500) [not null]
  created_at timestamp [default: `now()`]
}

Table reviews.review_votes [headercolor: #e67e22] {
  id int [pk, increment]
  review_id int [not null, ref: > reviews.product_reviews.id]
  user_id int [not null, ref: > core.users.id]
  is_helpful boolean [not null]
  created_at timestamp [default: `now()`]
  
  indexes {
    (review_id, user_id) [unique]
  }
}

// =====================================================
// TABLE GROUPS
// =====================================================

TableGroup core_entities [color: #3498db] {
  core.users
  core.user_roles
  core.roles
  core.addresses
}

TableGroup catalog_entities [color: #9b59b6] {
  catalog.categories
  catalog.brands
  catalog.products
  catalog.product_variants
  catalog.product_images
  catalog.product_tags
  catalog.tags
}

TableGroup sales_entities [color: #e74c3c] {
  sales.carts
  sales.cart_items
  sales.orders
  sales.order_items
  sales.order_history
  sales.coupons
}

TableGroup payment_entities [color: #f39c12] {
  payments.transactions
  payments.refunds
  payments.payment_methods
}

TableGroup inventory_entities [color: #1abc9c] {
  inventory.warehouses
  inventory.stock
  inventory.stock_movements
}

TableGroup review_entities [color: #e67e22] {
  reviews.product_reviews
  reviews.review_images
  reviews.review_votes
}

// =====================================================
// ENUMS
// =====================================================

Enum address_type {
  home
  work
  shipping
  billing
  other
}

Enum cart_status {
  active
  abandoned
  converted
  expired
}

Enum order_status {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

Enum payment_method {
  credit_card
  debit_card
  pix
  boleto
  wallet
  bank_transfer
}

Enum payment_status {
  pending
  processing
  completed
  failed
  cancelled
  refunded
}

Enum refund_status {
  pending
  approved
  processing
  completed
  rejected
}

Enum discount_type {
  percentage
  fixed_amount
  free_shipping
}

Enum stock_movement_type {
  purchase
  sale
  return
  adjustment
  transfer
  damaged
  expired
}
