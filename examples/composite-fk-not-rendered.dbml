// Minimal reproduction for DBML Preview 1.3.0
//
// Expected: 3 relationships
// Actual:   2 relationships
// Missing:  inspection.(organization_id, source_asset_id)
//           > object_asset.(organization_id, asset_id)

Project composite_fk_reproduction {
  database_type: 'PostgreSQL'
}

Table organization {
  organization_id uuid [pk]
  name varchar [not null]
}

Table object_asset {
  organization_id uuid [not null]
  asset_id uuid [not null]
  object_key varchar [not null]

  indexes {
    (organization_id, asset_id) [pk]
  }
}

Table inspection {
  organization_id uuid [not null]
  inspection_id uuid [pk]
  source_asset_id uuid [not null]
}

// These two scalar foreign keys are rendered correctly.
Ref: object_asset.organization_id > organization.organization_id
Ref: inspection.organization_id > organization.organization_id

// This valid composite foreign key is not rendered by DBML Preview 1.3.0.
Ref: inspection.(organization_id, source_asset_id) > object_asset.(organization_id, asset_id)
